+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { createMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { StreamChunk } from '@deepseek-ai/dsh-llm'
+import type { Context as PiContext } from '@earendil-works/pi-ai'
+
+const streamSimple = vi.hoisted(() => vi.fn())
+
+vi.mock('@earendil-works/pi-ai/api/openai-responses.lazy', () => ({
+  openAIResponsesApi: () => ({ stream: streamSimple, streamSimple }),
+}))
+
+import { PiAiAdapter } from '../src/adapter.ts'
+import { resolveProfiles } from '../src/config.ts'
+import { memoryAuth } from './auth-double.ts'
+
+afterEach(() => { streamSimple.mockReset() })
+
+function adapter(): PiAiAdapter {
+  return new PiAiAdapter({
+    profiles: () => resolveProfiles({
+      gateway: {
+        api: 'openai-responses',
+        baseURL: 'http://127.0.0.1:9/v1',
+        models: [{ id: 'deepseek-v4.1-flash', contextWindow: 8192, maxTokens: 1024 }],
+        repeatReasoningBeforeEachToolCallModels: ['deepseek-v4.1-flash'],
+      },
+    }),
+    resolveApiKey: () => Promise.resolve('test-key'),
+    auth: memoryAuth(),
+  })
+}
+
+async function drain(value: PiAiAdapter): Promise<StreamChunk[]> {
+  const reasoning = JSON.stringify({
+    id: 'rs_1', type: 'reasoning', status: 'completed',
+    content: [{ type: 'reasoning_text', text: 'inspect both files' }],
+    encrypted_content: 'encrypted',
+  })
+  const chunks: StreamChunk[] = []
+  for await (const chunk of value.stream({
+    provider: 'gateway',
+    model: 'deepseek-v4.1-flash',
+    messages: [
+      createMessage({
+        role: 'assistant',
+        content: [
+          { type: 'reasoning', text: 'inspect both files' },
+          { type: 'tool-call', id: ToolCallId('c1'), name: 'read', arguments: '{"path":"a"}' },
+          { type: 'tool-call', id: ToolCallId('c2'), name: 'read', arguments: '{"path":"b"}' },
+        ],
+        source: {
+          kind: 'model', provider: 'gateway', model: 'deepseek-v4.1-flash',
+          replayState: {
+            response: {
+              kind: 'pi-ai', version: 2, api: 'openai-responses', provider: 'gateway',
+              model: 'deepseek-v4.1-flash', stopReason: 'toolUse',
+            },
+            blocks: [
+              { type: 'reasoning', thinkingSignature: reasoning },
+              { type: 'tool-call' },
+              { type: 'tool-call' },
+            ],
+          },
+        },
+      }),
+      createToolResultMessage({
+        callId: ToolCallId('c1'),
+        content: [{ type: 'text', text: 'a' }],
+        isError: false,
+      }),
+      createToolResultMessage({
+        callId: ToolCallId('c2'),
+        content: [{ type: 'text', text: 'b' }],
+        isError: false,
+      }),
+    ],
+  })) chunks.push(chunk)
+  return chunks
+}
+
+describe('Responses reasoning replay', () => {
+  it('projects configured multi-tool history at the SDK boundary', async () => {
+    streamSimple.mockImplementation(() => { throw new Error('inspect request') })
+
+    await drain(adapter())
+
+    const context = streamSimple.mock.calls[0]?.[1] as PiContext | undefined
+    expect(context?.messages.map(message => message.role)).toEqual([
+      'assistant', 'toolResult', 'assistant', 'toolResult',
+    ])
+    const [firstCall, firstResult, secondCall, secondResult] = context?.messages ?? []
+    if (firstCall?.role !== 'assistant' || secondCall?.role !== 'assistant'
+      || firstResult?.role !== 'toolResult' || secondResult?.role !== 'toolResult') {
+      throw new Error('expected interleaved request history')
+    }
+    expect(firstCall.content.map(block => block.type)).toEqual(['thinking', 'toolCall'])
+    expect(firstResult.toolCallId).toBe('c1')
+    expect(secondCall.content.map(block => block.type)).toEqual(['thinking', 'toolCall'])
+    expect(secondResult.toolCallId).toBe('c2')
+  })
+})
