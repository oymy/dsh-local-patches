+/**
+ * Repeat the latest signed Responses prelude before each tool call in a
+ * contiguous run. The prelude contains the reasoning item and any assistant
+ * text emitted before the first call. DeepSeek-compatible gateways may bind
+ * that complete prelude to one call, so replaying only the reasoning item loses
+ * the following calls when commentary is present. Unsigned reasoning cannot
+ * reconstruct the native Responses item and therefore remains unchanged.
+ * @param context - converted pi-ai request context.
+ * @returns a context with affected assistant histories projected for replay.
+ */
+export function repeatReasoningBeforeEachToolCall(context: PiContext): PiContext {
+  let changed = false
+  const projected: PiMessage[] = []
+  for (const message of context.messages) {
+    if (message.role !== 'assistant') {
+      projected.push(message)
+      continue
+    }
+    let prelude: AssistantMessage['content'] | undefined
+    let firstToolSeen = false
+    let messageChanged = false
+    const content: AssistantMessage['content'] = []
+    for (const block of message.content) {
+      if (block.type === 'thinking') {
+        prelude = block.thinkingSignature === undefined ? undefined : [block]
+        firstToolSeen = false
+      } else if (block.type === 'text' && prelude !== undefined && !firstToolSeen) {
+        prelude.push(block)
+      } else if (block.type === 'toolCall') {
+        if (prelude !== undefined && firstToolSeen) {
+          content.push(...prelude)
+          changed = true
+          messageChanged = true
+        }
+        firstToolSeen = prelude !== undefined
+      }
+      content.push(block)
+    }
+    projected.push(messageChanged ? { ...message, content } : message)
+  }
+  if (!changed) return context
+
+  // DeepSeek's Responses endpoint currently requires each function call and
+  // its output to be adjacent in the flattened input array. pi-ai ordinarily
+  // emits all calls from an assistant message before all following results.
+  // Split a fully matched run so conversion produces call/output pairs while
+  // retaining the signed prelude before every call.
+  const messages: PiMessage[] = []
+  for (let index = 0; index < projected.length; index++) {
+    const message = projected[index] as PiMessage
+    if (message.role !== 'assistant') {
+      messages.push(message)
+      continue
+    }
+    const calls = message.content.filter(block => block.type === 'toolCall')
+    const results: Extract<PiMessage, { role: 'toolResult' }>[] = []
+    for (let resultIndex = index + 1; resultIndex < projected.length; resultIndex++) {
+      const candidate = projected[resultIndex] as PiMessage
+      if (candidate.role !== 'toolResult') break
+      results.push(candidate)
+    }
+    const resultsByCall = new Map(results.map(result => [result.toolCallId, result]))
+    if (calls.length < 2 || results.length !== calls.length
+      || calls.some(call => !resultsByCall.has(call.id))) {
+      messages.push(message)
+      continue
+    }
+    let segment: AssistantMessage['content'] = []
+    for (const block of message.content) {
+      segment.push(block)
+      if (block.type !== 'toolCall') continue
+      messages.push({ ...message, content: segment })
+      messages.push(resultsByCall.get(block.id) as Extract<PiMessage, { role: 'toolResult' }>)
+      segment = []
+    }
+    if (segment.length > 0) messages.push({ ...message, content: segment })
+    index += results.length
+  }
+  return { ...context, messages }
+}
